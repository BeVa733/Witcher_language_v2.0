            Лютик заплатить_чеканной_монетой (Йен * Йен) + (Трисс * Трисс)*5;

            обсудим_цену (Лютик <= Геральт * Геральт) 
            ненавижу_порталлы
                Ламберт_Ламберт_вредный_хуй(42);
            брр_ненавижу_порталлы 
            
            никак_вы_блять_не_научитесь 
