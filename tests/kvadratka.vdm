заказ проклятое_дитя() 
ненавижу_порталлы
    аксий(Весемир);
    аксий(Эскель);
    аксий(Лето);

    обсудим_цену (Весемир сыграем_в_Гвинт 0) 
    ненавижу_порталлы
        обсудим_цену (Эскель сыграем_в_Гвинт 0) 
        ненавижу_порталлы
            обсудим_цену (Лето сыграем_в_Гвинт 0) 
            ненавижу_порталлы
                Ламберт_Ламберт_вредный_хуй(нет корней 10);
                разойдись_свинопасы -2;
            брр_ненавижу_порталлы 

            никак_вы_блять_не_научитесь 
            ненавижу_порталлы
                Ламберт_Ламберт_вредный_хуй(попа 10);
                Ламберт_Ламберт_хер_моржовый(0);
                разойдись_свинопасы 0;
            брр_ненавижу_порталлы
        брр_ненавижу_порталлы 

        никак_вы_блять_не_научитесь 
        ненавижу_порталлы
            Плотва заплатить_чеканной_монетой - Лето / Эскель;
            Ламберт_Ламберт_вредный_хуй(Один корень 10);
            Ламберт_Ламберт_хер_моржовый(Плотва);
            Ламберт_Ламберт_вредный_хуй(10);
            разойдись_свинопасы 1;
        брр_ненавижу_порталлы
    брр_ненавижу_порталлы

    Цири заплатить_чеканной_монетой Эскель * Эскель - 4 * Весемир * Лето;

    обсудим_цену (Цири лень_делает_счастливым 0) 
    ненавижу_порталлы
        Ламберт_Ламберт_хер_моржовый(0);
        разойдись_свинопасы 0;
    брр_ненавижу_порталлы

    обсудим_цену (Цири сыграем_в_Гвинт 0) 
    ненавижу_порталлы
        Плотва заплатить_чеканной_монетой Эскель / (2 * Весемир);
        Ламберт_Ламберт_вредный_хуй(один корень 10);
        Ламберт_Ламберт_хер_моржовый(Плотва);
        Ламберт_Ламберт_вредный_хуй(10);
        разойдись_свинопасы 1;
    брр_ненавижу_порталлы

    Ласточка заплатить_чеканной_монетой вилохвост(Цири);
    Плотва1 заплатить_чеканной_монетой (- Эскель - Ласточка) / (2 * Весемир);
    Плотва2 заплатить_чеканной_монетой (- Эскель + Ласточка) / (2 * Весемир);

    Ламберт_Ламберт_вредный_хуй(два корня 10);
    Ламберт_Ламберт_хер_моржовый(Плотва1);
    Ламберт_Ламберт_вредный_хуй(10);
    Ламберт_Ламберт_хер_моржовый(Плотва2);
    Ламберт_Ламберт_вредный_хуй(10);

    разойдись_свинопасы 2;
брр_ненавижу_порталлы

заказ вилохвост(Йенифер) ненавижу_порталлы
    корень_душистого_перца заплатить_чеканной_монетой 0;
    я_тут_осмотрюсь_пока (корень_душистого_перца * корень_душистого_перца лень_делает_счастливым Йенифер) 
    ненавижу_порталлы
        корень_душистого_перца заплатить_чеканной_монетой корень_душистого_перца + 1;
    брр_ненавижу_порталлы
    разойдись_свинопасы корень_душистого_перца;
брр_ненавижу_порталлы
