заказ грифон(Трисс) ненавижу_порталлы
    обсудим_цену (Трисс лень_делает_счастливым 1) ненавижу_порталлы
        разойдись_свинопасы 1;
    брр_ненавижу_порталлы никак_вы_блять_не_научитесь ненавижу_порталлы
        разойдись_свинопасы Трисс * грифон(Трисс - 1);
